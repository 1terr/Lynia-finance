# ============================================================================
# Lynia Finance - Production Environment Configuration Template
# ============================================================================
# IMPORTANT: Never commit actual production values. This template documents
# the required variables. Actual secrets are stored in AWS Secrets Manager.
#
# To use: Copy to .env.production.local and fill in values for local testing.
# Production Lambda functions read from Secrets Manager, not .env files.
# ============================================================================

# ------------------------------------------
# Environment
# ------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
SECRETS_PREFIX=production/lynia

# ------------------------------------------
# AWS Configuration
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<your-aws-account-id>

# ------------------------------------------
# Supabase (Production Project - separate from staging)
# ------------------------------------------
SUPABASE_URL=<production-supabase-url>
SUPABASE_ANON_KEY=<production-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>

# Database Connection Pooling (PgBouncer)
DATABASE_POOLER_URL=<production-pooler-url>:6543
DATABASE_DIRECT_URL=<production-direct-url>:5432
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL_MODE=require

# ------------------------------------------
# WhatsApp Cloud API (Production)
# ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=<production-phone-number-id>
WHATSAPP_ACCESS_TOKEN=<production-access-token>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<production-webhook-verify-token>
WHATSAPP_API_VERSION=v18.0
WHATSAPP_BUSINESS_ACCOUNT_ID=<production-business-account-id>

# ------------------------------------------
# Smile Identity (KYC - Production)
# ------------------------------------------
SMILE_PARTNER_ID=<production-partner-id>
SMILE_API_KEY=<production-api-key>
SMILE_ENVIRONMENT=production

# ------------------------------------------
# EcoCash (Production)
# ------------------------------------------
ECOCASH_MERCHANT_ID=<production-merchant-id>
ECOCASH_API_KEY=<production-api-key>
ECOCASH_API_URL=https://api.ecocash.co.zw
ECOCASH_CALLBACK_URL=https://api.lyniafinance.com/payments/webhook

# ------------------------------------------
# OneMoney (Production)
# ------------------------------------------
ONEMONEY_MERCHANT_ID=<production-merchant-id>
ONEMONEY_API_KEY=<production-api-key>
ONEMONEY_API_URL=https://api.onemoney.co.zw
ONEMONEY_CALLBACK_URL=https://api.lyniafinance.com/payments/webhook

# ------------------------------------------
# Trustonic (Device Lock - Production)
# ------------------------------------------
TRUSTONIC_API_KEY=<production-api-key>
TRUSTONIC_API_SECRET=<production-api-secret>
TRUSTONIC_API_URL=https://api.trustonic.com

# ------------------------------------------
# SMS Provider (Production)
# ------------------------------------------
SMS_PROVIDER=africas_talking
SMS_API_KEY=<production-api-key>
SMS_SENDER_ID=Lynia

# ------------------------------------------
# Domain Configuration
# ------------------------------------------
API_DOMAIN=api.lyniafinance.com
ADMIN_DOMAIN=admin.lyniafinance.com
DISTRIBUTOR_DOMAIN=distributor.lyniafinance.com
API_BASE_URL=https://api.lyniafinance.com

# ------------------------------------------
# Rate Limiting
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# Feature Flags (Production defaults)
# ------------------------------------------
FEATURE_SMS_OTP=true
FEATURE_WHATSAPP_OTP=true
FEATURE_DEVICE_LOCK=true
FEATURE_MULTI_PRODUCT=false
FEATURE_AGENT_INVENTORY=true
FEATURE_CREDIT_SCORING_V2=false

# ------------------------------------------
# Frontend (Next.js public variables)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=<production-supabase-url>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production-anon-key>
NEXT_PUBLIC_API_URL=https://api.lyniafinance.com
NEXT_PUBLIC_ENVIRONMENT=production
