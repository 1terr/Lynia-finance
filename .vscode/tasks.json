{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pnpm install",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "pnpm build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "pnpm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Tests (Coverage)",
      "type": "shell",
      "command": "pnpm test:coverage",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "SAM Build",
      "type": "shell",
      "command": "sam build --cached --parallel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "SAM Local API",
      "type": "shell",
      "command": "sam local start-api --port 3000",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Database Migrate",
      "type": "shell",
      "command": "pnpm db:migrate",
      "problemMatcher": []
    }
  ]
}
