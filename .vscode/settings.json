{
  // === Editor Core ===
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.suggestSelection": "first",
  "editor.linkedEditing": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.fontLigatures": true,

  // === Terminal (Claude Code runs here) ===
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.profiles.windows": {
    "Claude Code": {
      "path": "bash",
      "args": ["-c", "claude"],
      "icon": "sparkle"
    }
  },

  // === TypeScript ===
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.suggest.autoImports": true,

  // === ESLint ===
  "eslint.validate": ["typescript", "typescriptreact", "javascript"],
  "eslint.workingDirectories": [
    "services",
    "frontend/admin-portal",
    "frontend/distributor-dashboard"
  ],

  // === Language-Specific Formatters ===
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": { "other": true, "comments": false, "strings": false }
  },

  // === Git & GitHub (core workflow) ===
  "git.autofetch": true,
  "git.autofetchPeriod": 120,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "git.branchProtection": ["master", "main"],
  "git.mergeEditor": true,
  "githubPullRequests.createOnPublishBranch": "ask",
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.fileListLayout": "tree",
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.codeLens.enabled": true,

  // === File Management ===
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/.aws-sam": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/.aws-sam/**": true
  },
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // === Search ===
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true,
    "**/.aws-sam": true
  },
  "search.smartCase": true,

  // === Explorer ===
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml, .npmrc, .eslintrc*, .prettierrc*, jest.config.*",
    "template.yaml": "samconfig.toml, .cfnlintrc",
    ".gitignore": ".gitattributes, .editorconfig"
  },

  // === Workbench (Desktop look & feel) ===
  "workbench.startupEditor": "none",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.showTabs": "multiple",
  "workbench.tree.indent": 16,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "breadcrumbs.enabled": true,

  // === YAML (CloudFormation/SAM templates) ===
  "yaml.schemas": {
    "https://raw.githubusercontent.com/aws/serverless-application-model/main/samtranslator/schema/schema.json": [
      "template.yaml",
      "template.yml"
    ]
  },
  "yaml.customTags": [
    "!Ref",
    "!Sub",
    "!GetAtt",
    "!If sequence",
    "!Not sequence",
    "!Equals sequence",
    "!Or sequence",
    "!And sequence",
    "!Select sequence",
    "!Split sequence",
    "!Join sequence",
    "!ImportValue",
    "!Condition"
  ]
}
