{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git update-ref:*)",
      "Bash(gh :*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh repo:*)",
      "Bash(gh run:*)",
      "Bash(.claude/scripts/update-master.sh)",
      "Bash(.claude/scripts/pre-commit-check.sh)",
      "Bash(.claude/scripts/auto-push.sh)",
      "Bash(.claude/scripts/setup-gh.sh)",
      "Bash(.claude/scripts/create-pr.sh)",
      "Bash(.claude/scripts/ensure-gh.sh)",
      "Bash(aws cloudformation describe-stack-events:*)",
      "Bash(python3:*)",
      "Bash(aws cloudformation update-stack:*)",
      "Bash(curl:*)",
      "Bash(unzip:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/update-master.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/scripts/ensure-gh.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ARGS=\"$CLAUDE_TOOL_INPUT\"; if echo \"$ARGS\" | grep -q '\"'\"'git commit'\"'\"'; then bash .claude/scripts/pre-commit-check.sh; fi'",
            "timeout": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ARGS=\"$CLAUDE_TOOL_INPUT\"; if echo \"$ARGS\" | grep -q '\"'\"'git commit'\"'\"'; then bash .claude/scripts/auto-push.sh; fi'",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
