# ==================================
# Lynia Finance - Environment Variables Template
# ==================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to Git!

# ----- Database (RDS PostgreSQL) -----
# Lambda functions read credentials from Secrets Manager (DB_SECRET_NAME).
# These are only needed for local development / running migrations directly.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lynia
DB_USER=lynia_admin
DB_PASSWORD=your-database-password-here  # KEEP SECRET!

# ----- WhatsApp Cloud API -----
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v18.0

# ----- KYC Provider (DIDIT) -----
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-secret

# ----- Mobile Money - EcoCash -----
ECOCASH_MERCHANT_ID=your-merchant-id
ECOCASH_API_KEY=your-api-key
ECOCASH_API_URL=https://sandbox.ecocash.co.zw/api/v1

# ----- Mobile Money - OneMoney -----
ONEMONEY_MERCHANT_ID=your-merchant-id
ONEMONEY_API_KEY=your-api-key
ONEMONEY_API_URL=https://sandbox.onemoney.co.zw/api/v1

# ----- AWS -----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ----- Application Config -----
NODE_ENV=development  # development, staging, production
PORT=3000
API_BASE_URL=http://localhost:3000

# ----- Security -----
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
ENCRYPTION_KEY=your-encryption-key-exactly-32-characters

# ----- Logging -----
LOG_LEVEL=debug  # debug, info, warn, error

# ----- Feature Flags -----
ENABLE_SMS_OTP=true
ENABLE_WHATSAPP_OTP=false
ENABLE_DEVICE_LOCK=true
ENABLE_MULTI_PRODUCT=false  # Phase 3 feature
ENABLE_AGENT_INVENTORY=false  # Phase 3 feature

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # per window

# ----- Database -----
DB_POOL_MIN=2
DB_POOL_MAX=10

# ----- SMS Provider (Optional) -----
SMS_PROVIDER=twilio  # twilio, africas_talking
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=Lynia

# ----- Monitoring (Optional) -----
SENTRY_DSN=your-sentry-dsn
ENABLE_MONITORING=false

# ----- Admin Dashboard / Frontend (Cognito) -----
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=us-east-1
